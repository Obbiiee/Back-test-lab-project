# Template only. Supply credentials via environment/secret manager, never Git.
# Owner/migration connection and runtime connection must be distinct in deployment.
BTL_DATABASE_URL=
# PostgreSQL bin directory for pg_dump/pg_restore, or leave blank to use PATH.
BTL_PG_BIN=
# Tests require a separate disposable database; never point to user data.
BTL_TEST_DATABASE_URL=
# Phase 21: generate at least 48 random bytes; never a committed/default secret.
BTL_AUTH_SECRET=
# TLS SMTP delivery is required by explicit cloud factory; QA injects a test sink.
BTL_SMTP_HOST=
BTL_SMTP_USER=
BTL_SMTP_PASSWORD=
BTL_SMTP_SENDER=
# Optional direct TLS or explicitly trusted reverse proxy; never wildcard trust.
BTL_TLS_CERT=
BTL_TLS_KEY=
BTL_TRUSTED_PROXY_IPS=
BTL_BIND_HOST=127.0.0.1
BTL_BIND_PORT=8001
