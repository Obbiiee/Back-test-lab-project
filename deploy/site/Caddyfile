# Public static site for riksora.com (marketing, pricing, policies). Served by Caddy in user space; HTTPS certificates are obtained automatically.
# Needs inbound 80 and 443 (one-time root step in README.md). The QA application/API is NOT exposed here.
riksora.com {
	root * {$SITE_ROOT:/home/developer/site/dist}
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=300"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@shell path / /index.html /sw.js /manifest.webmanifest
	header @shell Cache-Control "no-cache"

	# only the static build is served; the application API is not proxied from this site (handle blocks decide before try_files rewrites the path)
	handle /api/v1/auth/* {
		reverse_proxy 127.0.0.1:8010
	}
	handle /api/v1/workspaces* {
		reverse_proxy 127.0.0.1:8010
	}
	handle /api/* {
		respond "Not found" 404
	}
	# Official application entry: /app opens sign-in and the workspace (the account entry lives at /?page=account).
	redir /app /?page=account 302
	redir /app/ /?page=account 302
	# Protected QA preview (owner decision 2026-11-18): the release frontend built with base /preview/. The Basic Auth credential is kept OUTSIDE the repository
	# (~/.config/riksora-preview-auth.caddy). OAuth callbacks under /api/v1/auth are not behind it. Remove this block after the production route is verified.
	redir /preview /preview/ 308
	handle /preview/* {
		import /home/developer/.config/riksora-preview-auth.caddy
		uri strip_prefix /preview
		root * {$PREVIEW_ROOT:/home/developer/site/preview}
		try_files {path} /index.html
		file_server
	}
	handle {
		try_files {path} /index.html
		file_server
	}
	log {
		output file {$SITE_LOG:/home/developer/site/access.log} {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

www.riksora.com {
	redir https://riksora.com{uri} permanent
}
