# Public Google-only API (loopback). systemd USER unit; Caddy proxies only the allowed paths to it.
[Unit]
Description=RIKSORA Google-only accounts API (127.0.0.1:8010)
After=riksora-pg.service
Requires=riksora-pg.service

[Service]
Type=simple
EnvironmentFile=%h/.config/riksora-google.env
ExecStart=%h/tools/venv313/bin/python %h/projects/Back-test-lab-project/deploy/site/accounts_api.py
Restart=on-failure
RestartSec=5
MemoryMax=1G

[Install]
WantedBy=default.target
