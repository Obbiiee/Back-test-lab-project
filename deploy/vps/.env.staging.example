# Copy to .env.staging on the dedicated Sorabit staging host and chmod 0600.
# Use a staging-only DNS name under a domain you control; never riksora.com.
BTL_PYTHON_IMAGE=
BTL_NODE_IMAGE=
BTL_CADDY_IMAGE=
BTL_POSTGRES_IMAGE=
BTL_DOMAIN=staging.example.invalid
BTL_ACME_EMAIL=
BTL_SECRET_DIR=/etc/riksora-staging
# Bounded queue/native worker pool; 1–4 only. Default remains 2.
BTL_RESEARCH_WORKERS=2
BTL_STAGING_AUTH_USER=owner
# Generate a bcrypt hash locally with Caddy; enter the staging password only into
# a private local prompt. Store only the resulting hash here.
BTL_STAGING_AUTH_HASH=
