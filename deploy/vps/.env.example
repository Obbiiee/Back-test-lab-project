# Private operator copy; no credentials in this file. All images require @sha256:<64 hex>.
BTL_PYTHON_IMAGE=
BTL_NODE_IMAGE=
BTL_CADDY_IMAGE=
# Choose PostgreSQL17 image matching documented volume layout; no automatic major upgrade.
BTL_POSTGRES_IMAGE=
BTL_DOMAIN=
BTL_ACME_EMAIL=
BTL_SECRET_DIR=/etc/backtest-lab
# Bounded queue/native worker pool; 1–4 only. Default remains 2.
# This is a configuration choice, not a capacity claim.
BTL_RESEARCH_WORKERS=2
