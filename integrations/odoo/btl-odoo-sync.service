[Unit]
Description=Backtest Lab bounded business sync to Odoo
[Service]
Type=oneshot
User=btl-business-sync
WorkingDirectory=/opt/backtest-lab
EnvironmentFile=/etc/backtest-lab/odoo-sync.env
Environment=PYTHONPATH=/opt/backtest-lab/backend
ExecStart=/opt/backtest-lab/backend/venv/bin/python -B integrations/odoo/sync.py
TimeoutStartSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
