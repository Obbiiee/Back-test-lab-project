[options]
; Copy privately into secrets/odoo.conf and set unique protected credentials.
admin_passwd = REPLACE_WITH_UNIQUE_DATABASE_MANAGER_SECRET
db_host = db
db_port = 5432
db_user = odoo
db_password = REPLACE_WITH_PRIVATE_ODOO_APP_DB_PASSWORD
db_name = odoo
dbfilter = ^odoo$
list_db = False
addons_path = /usr/lib/python3/dist-packages/odoo/addons,/mnt/extra-addons
data_dir = /var/lib/odoo
http_interface = 0.0.0.0
http_port = 8069
proxy_mode = False
workers = 0
max_cron_threads = 0
