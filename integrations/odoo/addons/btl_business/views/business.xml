<odoo>
 <record id="support_list" model="ir.ui.view"><field name="name">btl.support.ticket.list</field><field name="model">btl.support.ticket</field><field name="arch" type="xml"><list><field name="name"/><field name="customer_id"/><field name="user_id"/><field name="state"/><field name="company_id"/></list></field></record>
 <record id="support_form" model="ir.ui.view"><field name="name">btl.support.ticket.form</field><field name="model">btl.support.ticket</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="customer_id"/><field name="user_id"/><field name="state"/><field name="company_id"/></group><field name="description" placeholder="Describe the customer question and resolution"/></sheet><chatter/></form></field></record>
 <record id="customer_list" model="ir.ui.view"><field name="name">btl.customer.list</field><field name="model">btl.customer</field><field name="arch" type="xml"><list create="false" edit="false" delete="false"><field name="email"/><field name="external_id"/><field name="partner_id"/><field name="company_id"/></list></field></record>
 <record id="payment_list" model="ir.ui.view"><field name="name">btl.payment.list</field><field name="model">btl.payment</field><field name="arch" type="xml"><list create="false" edit="false" delete="false"><field name="external_id"/><field name="customer_id"/><field name="mode"/><field name="phase"/><field name="amount_idr"/><field name="revision"/></list></field></record>
 <record id="cash_form" model="ir.ui.view"><field name="name">btl.cash.entry.form</field><field name="model">btl.cash.entry</field><field name="arch" type="xml"><form><header><button name="action_confirm" type="object" string="Confirm evidenced cash entry" invisible="state != 'draft'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name" readonly="state == 'posted'"/><field name="company_id" readonly="state == 'posted'"/><field name="date" readonly="state == 'posted'"/><field name="direction" readonly="state == 'posted'"/><field name="category" readonly="state == 'posted'"/><field name="amount_idr" readonly="state == 'posted'"/><field name="evidence" readonly="state == 'posted'"/></group></sheet><chatter/></form></field></record>
 <record id="cash_list" model="ir.ui.view"><field name="name">btl.cash.entry.list</field><field name="model">btl.cash.entry</field><field name="arch" type="xml"><list><field name="date"/><field name="name"/><field name="direction"/><field name="category"/><field name="amount_idr"/><field name="state"/><field name="signed_idr" sum="Confirmed net cash IDR"/></list></field></record>
 <record id="cash_pivot" model="ir.ui.view"><field name="name">btl.cash.entry.pivot</field><field name="model">btl.cash.entry</field><field name="arch" type="xml"><pivot string="Confirmed cash movement"><field name="category" type="row"/><field name="date" interval="month" type="col"/><field name="signed_idr" type="measure"/></pivot></field></record>
 <record id="import_form" model="ir.ui.view"><field name="name">btl.import.batch.form</field><field name="model">btl.import.batch</field><field name="arch" type="xml"><form><p>Sandbox projection only. This does not create revenue, invoices, cash or Pro access.</p><group><field name="filename" invisible="True"/><field name="file" filename="filename"/></group><footer><button name="action_import" string="Import reviewed snapshot" type="object" class="btn-primary"/><button string="Cancel" special="cancel"/></footer></form></field></record>
 <record id="customers_action" model="ir.actions.act_window"><field name="name">Customers</field><field name="res_model">btl.customer</field><field name="view_mode">list,form</field></record>
 <record id="payments_action" model="ir.actions.act_window"><field name="name">Sandbox payments (no real funds)</field><field name="res_model">btl.payment</field><field name="view_mode">list,form</field></record>
 <record id="support_action" model="ir.actions.act_window"><field name="name">Support tickets</field><field name="res_model">btl.support.ticket</field><field name="view_mode">list,form</field></record>
 <record id="cash_action" model="ir.actions.act_window"><field name="name">Manual IDR cashbook</field><field name="res_model">btl.cash.entry</field><field name="view_mode">list,form,pivot,graph</field></record>
 <record id="import_action" model="ir.actions.act_window"><field name="name">Import sandbox snapshot</field><field name="res_model">btl.import.batch</field><field name="view_mode">form</field><field name="target">new</field></record>
 <menuitem id="business_menu" name="Backtest Business" groups="group_crm"/>
 <menuitem id="customers_menu" name="Customers" parent="business_menu" action="customers_action"/>
 <menuitem id="payments_menu" name="Sandbox payment records" parent="business_menu" action="payments_action"/>
 <menuitem id="support_menu" name="Support" parent="business_menu" action="support_action"/>
 <menuitem id="cash_menu" name="Cashbook" parent="business_menu" action="cash_action" groups="group_finance"/>
 <menuitem id="import_menu" name="Import reviewed snapshot" parent="business_menu" action="import_action" groups="group_import"/>
</odoo>